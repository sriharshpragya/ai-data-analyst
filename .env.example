cat > .env.example << 'EOF'
# ============================================
# AI Data Analyst - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# LLM API (OpenRouter recommended for cost)
OPENROUTER_API_KEY=your-openrouter-api-key-here
LLM_MODEL=openai/gpt-4o-mini

# Alternatively use OpenAI directly:
# OPENAI_API_KEY=your-openai-key
# LLM_MODEL=gpt-4o-mini

# Database Configuration
# For local Docker (default):
DATABASE_URL=postgresql://analyst:analyst_password@postgres:5432/ecommerce

# For custom database:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Safety Configuration
QUERY_TIMEOUT_SECONDS=10
MAX_QUERY_COST=10000
MAX_ROWS_PER_QUERY=1000
DEFAULT_ROWS_PER_QUERY=100

# Chart Configuration
CHARTS_DIR=charts
EOF